{
	"name": "erapor-pmk",
	"private": true,
	"version": "0.1.6",
	"type": "module",
	"scripts": {
		"db:push": "node scripts/migrate-installed-db.mjs",
		"seed:walis": "node scripts/seed-wali-users.mjs",
		"db:studio": "drizzle-kit studio",
		"db:cleanup": "node scripts/cleanup-orphans.mjs",
		"db:purge": "node scripts/purge-db.mjs",
		"dev": "node scripts/dev.js",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node scripts/start-build.mjs",
		"release": "node scripts/release.mjs",
		"prepare": "node scripts/icon.js --once && (svelte-kit sync || echo '')",
		"logo:icons": "node scripts/generate-logo-icons.mjs",
		"logo:wizard": "node scripts/generate-wizard-images.mjs",
		"version": "node scripts/update-version.mjs",
		"check": "svelte-kit sync && node scripts/svelte-check-wrapper.mjs",
		"check:watch": "svelte-kit sync && node scripts/svelte-check-wrapper.mjs --watch",
		"tes-bell": "node scripts/test-bell.mjs",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prod": "node scripts/cleanup-db.mjs && node scripts/prod-unsigned.mjs",
		"prod:signed": "node scripts/cleanup-db.mjs && node scripts/prod-signed.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.1.0",
		"@types/qrcode": "^1.5.6",
		"daisyui": "^5.6.13",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1",
		"vite": "^8.1.3",
		"vite-plugin-devtools-json": "^1.0.0",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@sparticuz/chromium": "^153.0.0",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"jsonrepair": "^3.15.0",
		"pagedjs": "0.4.3",
		"pagedjs-cli": "^0.4.3",
		"pdf-lib": "^1.17.1",
		"puppeteer-core": "^25.3.0",
		"qrcode": "^1.5.4",
		"unzipper": "^0.12.5"
	}
}
